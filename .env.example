# Copy to .env next to docker-compose.yaml. kubernetes.yaml has the same keys in its Secret.
# Google sign-in: on when GOOGLE_CLIENT_ID is set. See gateway/auth.go.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these Google accounts may sign in (comma-separated). Empty = any verified account.
ALLOWED_EMAILS=
# Admins (comma-separated): the Admin page, to manage who can sign in and sign out or ban members. Needs Google sign-in.
ADMIN_EMAILS=

# Hosting: the public https address. Add BASE_URL/auth/callback as a redirect URI on the Google OAuth client.
BASE_URL=
# Where the app listens on the host (default 127.0.0.1:8000). Reverse proxy on another machine: 8000, or <this-lan-ip>:8000.
NAGARE_PORT=

# Per-user workspace containers.
WORKSPACE_IDLE_MINUTES=15
MAX_WORKSPACES=50
WORKSPACE_CPUS=1
WORKSPACE_MEMORY=1g
# Stronger isolation if gVisor is installed on the host: WORKSPACE_RUNTIME=runsc
WORKSPACE_RUNTIME=

# Image to run (default ghcr.io/maaboudoufu/nagare:latest). For a local build: docker build -t nagare . and set nagare.
NAGARE_IMAGE=
